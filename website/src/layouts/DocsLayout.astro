---
// Docs pages: remarque's Reference/Docs archetype (#7199) — nav rail,
// breadcrumb kicker, 46rem reading column, "on this page" rail, prev/next.
//
// Its own document rather than a BaseLayout child: BaseLayout carries the
// landing page's editorial stylesheet (global.css), whose unlayered element
// rules would fight remarque's. Shared <head> metadata and page scripts are
// components both layouts use.
//
// The nav is generated from the docs collection (src/lib/docs-nav.ts), so a
// published page cannot be missing from it: pages without a `diataxis`
// value are listed under "Unsorted" until the backfill (#7196).
import type { MarkdownHeading } from 'astro';
import SiteHead from '../components/SiteHead.astro';
import PageScripts from '../components/PageScripts.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchBox from '../components/SearchBox.svelte';
import { NEXUS_AGENTS_VERSION } from '../data/site-data';
import {
  API_INDEX_HREF,
  BASE,
  docsHref,
  getPublishedDocs,
  toNavPage,
} from '../lib/docs-collection.ts';
import {
  buildNav,
  findNeighbors,
  findSection,
  navLabel,
  pageTypeLabel,
  samePage,
  type Diataxis,
  type PageSource,
} from '../lib/docs-nav.ts';
import '../styles/docs.css';

interface Props {
  title: string;
  description?: string | undefined;
  headings?: MarkdownHeading[];
  diataxis?: Diataxis | undefined;
  /** Where the content comes from: an edit link, or the generator. */
  source?: PageSource | undefined;
  /** `api` for the generated TypeDoc pages, which sit under one nav entry. */
  section?: 'docs' | 'api';
}

const { title, description, headings = [], diataxis, source, section = 'docs' } = Astro.props;
const pathname = Astro.url.pathname;

const apiIndex = { id: 'api', href: API_INDEX_HREF, title: 'API reference', order: 0 };
const nav = buildNav((await getPublishedDocs()).map(toNavPage), { reference: [apiIndex] });

// An API sub-page is not itself in the nav; it lives under the API index.
const navHref = section === 'api' ? API_INDEX_HREF : pathname;
const currentSection = findSection(nav, navHref);
const isApiSubpage = section === 'api' && !samePage(pathname, API_INDEX_HREF);
// On an API sub-page the API index link marks where the reader is, but it is
// not this page, so it gets aria-current="true" rather than "page".
const currentToken = isApiSubpage ? 'true' : 'page';
const { prev, next } = isApiSubpage ? { prev: undefined, next: undefined } : findNeighbors(nav, pathname);

// The header links to the first page of each reader-facing section.
const primarySections = nav.filter((s) => ['start', 'how-to', 'reference', 'concepts'].includes(s.key));

const docsHome = docsHref('readme');
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const railSections = nav.map((s) => ({
  ...s,
  // Long buckets of backfill debt start collapsed unless they hold this page.
  collapsible: s.key === 'unsorted' || s.key === 'other',
  open: s === currentSection,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} />
    <ThemeInit />
  </head>
  <body>
    <a class="docs-skip-link" href="#main">Skip to content</a>

    <header class="docs-masthead">
      <div class="docs-masthead-inner">
        <a class="docs-wordmark" href={`${BASE}/`}>nexus-agents</a>
        <nav class="docs-primary-nav" aria-label="Primary">
          <ul>
            {primarySections.map((s) => (
              <li>
                <a href={s.pages[0]?.href} aria-current={s === currentSection ? 'true' : undefined}>
                  {s.label}
                </a>
              </li>
            ))}
            <li>
              <a href="https://github.com/nexus-substrate/nexus-agents">GitHub</a>
            </li>
          </ul>
        </nav>
        <SearchBox base={BASE} client:load />
        <ThemeToggle />
      </div>
    </header>

    <div class="docs-page">
      <nav class="docs-rail" aria-label="Documentation">
        <details open data-collapse-below="64rem">
          <summary>Documentation index</summary>
          <div class="docs-rail-sections">
            {railSections.map((s) =>
              s.collapsible ? (
                <details class="docs-rail-group" open={s.open}>
                  <summary>
                    {s.label} ({s.pages.length})
                  </summary>
                  <ul>
                    {s.pages.map((p) => (
                      <li>
                        <a href={p.href} aria-current={samePage(p.href, navHref) ? currentToken : undefined}>
                          {navLabel(p)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <div>
                  <h2>{s.label}</h2>
                  <ul>
                    {s.pages.map((p) => (
                      <li>
                        <a href={p.href} aria-current={samePage(p.href, navHref) ? currentToken : undefined}>
                          {navLabel(p)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ),
            )}
          </div>
        </details>
        <script is:inline>
          // Below the breakpoint where it gets its own column, a disclosure
          // starts collapsed, so the first screen shows the page rather than
          // 100+ links. Runs synchronously right after the element; without
          // JS it stays open.
          (function () {
            var el = document.currentScript && document.currentScript.previousElementSibling;
            if (el && !window.matchMedia('(min-width: ' + el.dataset.collapseBelow + ')').matches) el.open = false;
          })();
        </script>
      </nav>

      <main id="main" class="docs-main" data-pagefind-body>
        <nav class="docs-breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
          <ol>
            <li><a href={docsHome}>Docs</a></li>
            {currentSection && <li>{currentSection.label}</li>}
            {isApiSubpage && (
              <li>
                <a href={API_INDEX_HREF}>API reference</a>
              </li>
            )}
            <li aria-current="page">{title}</li>
          </ol>
        </nav>


        <article class="docs-body remarque-prose">
          <slot />
        </article>

        <aside class="docs-aside" aria-label="About this page" data-pagefind-ignore>
          {tocHeadings.length > 0 && (
            <nav class="remarque-toc-rail" aria-label="On this page">
              <details open>
                <summary>On this page</summary>
                <ul>
                  {tocHeadings.map((h) => (
                    <li class={`depth-${h.depth}`}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </details>
            </nav>
          )}
          <dl class="docs-page-meta">
            <dt>Page type</dt>
            <dd>{pageTypeLabel(diataxis)}</dd>
            {source && (
              <>
                <dt>Source</dt>
                {source.kind === 'edit' ? (
                  <dd><a href={source.url}>Edit this page on GitHub</a></dd>
                ) : (
                  <dd>{source.partial ? 'Partly generated by' : 'Generated from'} <code>{source.source}</code></dd>
                )}
              </>
            )}
          </dl>
        </aside>

        {(prev || next) && (
          <nav class="docs-pager" aria-label="Previous and next" data-pagefind-ignore>
            <ul>
              {prev && (
                <li>
                  <a href={prev.href} rel="prev">
                    <span class="docs-pager-label">Previous</span>
                    <span>{navLabel(prev)}</span>
                  </a>
                </li>
              )}
              {next && (
                <li class="docs-pager-next">
                  <a href={next.href} rel="next">
                    <span class="docs-pager-label">Next</span>
                    <span>{navLabel(next)}</span>
                  </a>
                </li>
              )}
            </ul>
          </nav>
        )}
      </main>
    </div>

    <footer class="docs-footer">
      <p>
        nexus-agents {NEXUS_AGENTS_VERSION} · MIT licensed ·
        <a href="https://github.com/nexus-substrate/nexus-agents">Source</a>
      </p>
    </footer>

    <PageScripts />
    <script>
      // Promote only the table wrappers that overflow to focusable, uniquely
      // named regions (src/lib/scroll-regions.ts). Re-run on resize and once
      // the web fonts settle, since both change which tables overflow.
      import { syncScrollRegions } from '../lib/scroll-regions.ts';

      let frame = 0;
      function schedule(): void {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => syncScrollRegions());
      }
      schedule();
      window.addEventListener('resize', schedule);
      void document.fonts.ready.then(schedule);
    </script>
  </body>
</html>

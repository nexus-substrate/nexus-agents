---
// Docs pages: remarque's Reference/Docs archetype (#7199) with the USWDS
// documentation shell (#7285). At 75rem and wider: side nav | content |
// in-page nav. From 64rem: side nav | content, with "On this page" as a
// disclosure right after the H1. Below 64rem: one column — breadcrumb, then
// the "Section navigation" disclosure, then the page, whose "On this page"
// disclosure again follows the H1. The in-page nav is spliced in after the
// H1 on the server, so DOM order is reading order at every width.
//
// Its own document rather than a BaseLayout child, because the rail and the
// aside change the page grid. Header, footer, <head> metadata, theme handling
// and page scripts are components both layouts use.
//
// The nav is generated from the docs collection (src/lib/docs-nav.ts), so a
// published page cannot be missing from it: pages without a `diataxis`
// value are listed under "Unsorted" until the backfill (#7196).
import type { MarkdownHeading } from 'astro';
import SiteHead from '../components/SiteHead.astro';
import PageScripts from '../components/PageScripts.astro';
import ThemeInit from '../components/ThemeInit.astro';
import SiteMasthead from '../components/SiteMasthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  API_INDEX_HREF,
  BASE,
  docsHref,
  getSiteNav,
} from '../lib/docs-collection.ts';
import {
  findNeighbors,
  findSection,
  navLabel,
  pageTypeLabel,
  PRIMARY_SECTIONS,
  samePage,
  sectionIndexHref,
  sectionLabel,
  splitAfterFirstH1,
  tocEntries,
  type Diataxis,
  type PageSource,
  type PrimarySectionKey,
} from '../lib/docs-nav.ts';
import '../styles/docs.css';

interface Props {
  title: string;
  description?: string | undefined;
  headings?: MarkdownHeading[];
  diataxis?: Diataxis | undefined;
  /** Where the content comes from: an edit link, or the generator. */
  source?: PageSource | undefined;
  /** `api` for the generated TypeDoc pages, which sit under one nav entry. */
  section?: 'docs' | 'api';
  /** Set on a generated section index page (src/pages/docs/[section].astro). */
  sectionIndex?: PrimarySectionKey | undefined;
}

const {
  title,
  description,
  headings = [],
  diataxis,
  source,
  section = 'docs',
  sectionIndex,
} = Astro.props;
const pathname = Astro.url.pathname;

const nav = await getSiteNav();

// An API sub-page is not itself in the nav; it lives under the API index.
const navHref = section === 'api' ? API_INDEX_HREF : pathname;
const currentSection = findSection(nav, navHref);
const isApiSubpage = section === 'api' && !samePage(pathname, API_INDEX_HREF);
// On an API sub-page the API index link marks where the reader is, but it is
// not this page, so it gets aria-current="true" rather than "page".
const currentToken = isApiSubpage ? 'true' : 'page';
const { prev, next } = isApiSubpage ? { prev: undefined, next: undefined } : findNeighbors(nav, pathname);

function asPrimary(key: string | undefined): PrimarySectionKey | undefined {
  return PRIMARY_SECTIONS.find((k) => k === key);
}
// The section the reader is in, for the header and the breadcrumb. A primary
// section's crumb links to its generated index page.
const primaryKey = sectionIndex ?? asPrimary(currentSection?.key);
const crumbLabel = sectionIndex ? sectionLabel(sectionIndex) : currentSection?.label;
const crumbHref = !sectionIndex && primaryKey ? sectionIndexHref(BASE, primaryKey) : undefined;

const docsHome = docsHref('readme');
const toc = tocEntries(headings);
const tocLimited = toc.length > 0 && toc.length < headings.filter((h) => h.depth === 2 || h.depth === 3).length;

// Every section is a disclosure; only the one holding this page starts open.
// Reference is split into sub-groups (docs-nav.ts), each its own disclosure.
const holds = (pages: ReadonlyArray<{ href: string }>): boolean =>
  pages.some((p) => samePage(p.href, navHref));
const railSections = nav.map((s) => ({
  ...s,
  open: s === currentSection,
  groups: s.groups?.map((g) => ({ ...g, open: holds(g.pages) })),
}));

// The page body, split after its H1 so the in-page nav can follow the title.
const bodyHtml = await Astro.slots.render('default');
const split = splitAfterFirstH1(bodyHtml);
const [beforeToc, afterToc] = split ?? ['', bodyHtml];
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead title={title} description={description} />
    <ThemeInit />
  </head>
  <body>
    <a class="docs-skip-link" href="#main">Skip to content</a>

    <SiteMasthead current={primaryKey} currentIsPage={sectionIndex !== undefined} />

    <div class="docs-page">
      <nav class="docs-breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
        <ol>
          <li><a href={docsHome}>Docs</a></li>
          {crumbLabel && !sectionIndex && (
            <li>{crumbHref ? <a href={crumbHref}>{crumbLabel}</a> : crumbLabel}</li>
          )}
          {isApiSubpage && (
            <li>
              <a href={API_INDEX_HREF}>API reference</a>
            </li>
          )}
          <li aria-current="page">{title}</li>
        </ol>
      </nav>

      <nav class="docs-rail" aria-label="Section navigation">
        <details open data-collapse-below="64rem">
          <summary>Section navigation</summary>
          <div class="docs-rail-sections">
            {railSections.map((s) => (
              <details class="docs-rail-group" open={s.open}>
                <summary>{s.label}</summary>
                {s.groups ? (
                  <ul>
                    {s.groups.map((g) => (
                      <li>
                        <details class="docs-rail-subgroup" open={g.open}>
                          <summary>
                            {g.label} <span class="docs-rail-count">({g.pages.length})</span>
                          </summary>
                          <ul>
                            {g.pages.map((p) => (
                              <li>
                                <a href={p.href} aria-current={samePage(p.href, navHref) ? currentToken : undefined}>
                                  {navLabel(p)}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </details>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <ul>
                    {s.pages.map((p) => (
                      <li>
                        <a href={p.href} aria-current={samePage(p.href, navHref) ? currentToken : undefined}>
                          {navLabel(p)}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </details>
            ))}
          </div>
        </details>
      </nav>
      <script is:inline>
        // Runs right after the side nav, before first paint. Below 64rem the
        // nav is a disclosure that starts closed, so the first screen shows
        // the page; from 64rem it is a column, forced open, and its current
        // link is scrolled into view inside the column (an instant scroll of
        // the column only: no page movement, no animation). Crossing the
        // breakpoint re-syncs. Without JS the disclosure stays open.
        (function () {
          var nav = document.currentScript && document.currentScript.previousElementSibling;
          var el = nav && nav.querySelector('details[data-collapse-below]');
          if (!el) return;
          var mq = window.matchMedia('(min-width: ' + el.dataset.collapseBelow + ')');
          el.open = mq.matches;
          mq.addEventListener('change', function () { el.open = mq.matches; });
          var current = mq.matches && nav.querySelector('a[aria-current]');
          if (current && nav.scrollHeight > nav.clientHeight) {
            nav.scrollTop = Math.max(0, current.offsetTop - nav.clientHeight / 3);
          }
        })();
      </script>

      <main id="main" class="docs-main" data-pagefind-body>
        <article class="docs-body remarque-prose">
          <Fragment set:html={beforeToc} />
          {toc.length > 0 && (
            <nav class="docs-toc remarque-toc-rail" aria-label="On this page" data-toc-spy data-pagefind-ignore>
              <details open data-collapse-below="75rem">
                <summary>On this page</summary>
                <ul>
                  {toc.map((h) => (
                    <li class={`depth-${h.depth}`}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
                {tocLimited && <p class="docs-toc-note">Major sections only.</p>}
              </details>
            </nav>
          )}
          {toc.length > 0 && (
            <script is:inline>
              // Same pre-paint sync as the side nav: below 75rem "On this
              // page" is a closed disclosure after the title; from 75rem it
              // is the right-hand column, forced open.
              (function () {
                var nav = document.currentScript && document.currentScript.previousElementSibling;
                var el = nav && nav.querySelector('details[data-collapse-below]');
                if (!el) return;
                var mq = window.matchMedia('(min-width: ' + el.dataset.collapseBelow + ')');
                el.open = mq.matches;
                mq.addEventListener('change', function () { el.open = mq.matches; });
              })();
            </script>
          )}
          <Fragment set:html={afterToc} />
        </article>

        <aside class="docs-aside" aria-label="About this page" data-pagefind-ignore>
          <dl class="docs-page-meta">
            <dt>Page type</dt>
            <dd>{pageTypeLabel(diataxis)}</dd>
            {source && (
              <>
                <dt>Source</dt>
                {source.kind === 'edit' ? (
                  <dd><a href={source.url}>Edit this page on GitHub</a></dd>
                ) : (
                  <dd>{source.partial ? 'Partly generated by' : 'Generated from'} <code>{source.source}</code></dd>
                )}
              </>
            )}
          </dl>
        </aside>

        {(prev || next) && (
          <nav class="docs-pager" aria-label="Previous and next" data-pagefind-ignore>
            <ul>
              {prev && (
                <li>
                  <a href={prev.href} rel="prev">
                    <span class="docs-pager-label">Previous</span>
                    <span>{navLabel(prev)}</span>
                  </a>
                </li>
              )}
              {next && (
                <li class="docs-pager-next">
                  <a href={next.href} rel="next">
                    <span class="docs-pager-label">Next</span>
                    <span>{navLabel(next)}</span>
                  </a>
                </li>
              )}
            </ul>
          </nav>
        )}
      </main>
    </div>

    <SiteFooter />

    <PageScripts />
    <script>
      // Promote only the table wrappers that overflow to focusable, uniquely
      // named regions (src/lib/scroll-regions.ts). Re-run on resize and once
      // the web fonts settle, since both change which tables overflow.
      import { syncScrollRegions } from '../lib/scroll-regions.ts';
      import { initTocSpy } from '../lib/toc-spy.ts';

      initTocSpy();

      let frame = 0;
      function schedule(): void {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => syncScrollRegions());
      }
      schedule();
      window.addEventListener('resize', schedule);
      void document.fonts.ready.then(schedule);
    </script>
  </body>
</html>

---
// Section index pages (#7199): /docs/start-here/, /docs/how-to/,
// /docs/reference/, /docs/concepts/. The Primary nav links here. Each lists
// its section's pages with their descriptions, from the same nav the rail
// renders (getSiteNav), so the two cannot disagree.
//
// A docs page whose collection id equals a section slug would be shadowed by
// this route; the build fails instead of silently dropping that page.
import DocsLayout from '../../layouts/DocsLayout.astro';
import Callout from '../../components/Callout.astro';
import { getPublishedDocs, getSiteNav } from '../../lib/docs-collection.ts';
import {
  PRIMARY_SECTIONS,
  navLabel,
  sectionIntro,
  sectionLabel,
  sectionListing,
  sectionRouteCollisions,
  sectionSlug,
  type PrimarySectionKey,
} from '../../lib/docs-nav.ts';

export async function getStaticPaths() {
  const collisions = sectionRouteCollisions((await getPublishedDocs()).map((entry) => entry.id));
  if (collisions.length > 0) {
    throw new Error(
      `docs page id(s) collide with section index routes: ${collisions.join(', ')}. ` +
        'Rename the page or change the slug in website/src/lib/docs-nav.ts.',
    );
  }
  return PRIMARY_SECTIONS.map((key) => ({ params: { section: sectionSlug(key) }, props: { key } }));
}

interface Props {
  key: PrimarySectionKey;
}

const { key } = Astro.props;
const label = sectionLabel(key);
const intro = sectionIntro(key);
const listing = sectionListing(await getSiteNav(), key);
---

<DocsLayout title={label} description={intro.summary} diataxis="none" sectionIndex={key}>
  <h1>{label}</h1>
  <p class="section-lead">{intro.summary}</p>

  {listing.provisional && (
    <Callout title="Provisional list">
      <p>
        No page has been classified into this section yet, so this list shows the unclassified
        pages from the matching directory. It is replaced by the classified pages as the Diátaxis
        backfill lands (<a href="https://github.com/nexus-substrate/nexus-agents/issues/7198">issue 7198</a>).
      </p>
    </Callout>
  )}

  {listing.pages.length === 0 ? (
    <p>
      No pages are classified into this section yet. Every published page is still reachable from
      the documentation index.
    </p>
  ) : (
    <dl>
      {listing.pages.map((page) => (
        <>
          <dt><a href={page.href}>{navLabel(page)}</a></dt>
          <dd>{page.description ?? 'No description yet.'}</dd>
        </>
      ))}
    </dl>
  )}
</DocsLayout>

<style>
  .section-lead {
    font-size: var(--text-body-lg);
    color: var(--color-fg-muted);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" description="The page you requested could not be found.">
  <div class="container">
    <p class="code">404</p>
    <h1 class="heading">Page Not Found</h1>
    <p class="message">The page you requested does not exist or has been moved.</p>
    <nav class="links" aria-label="Recovery links">
      <a href="/nexus-agents/" class="link-primary">Go to Home</a>
      <a href="/nexus-agents/docs/readme/" class="link-secondary">View Documentation</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 40rem;
    margin: 8rem auto;
    padding: 0 1.5rem;
    text-align: center;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-outline-variant);
    margin: 0 0 1rem;
  }

  .heading {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-on-surface);
    margin: 0 0 0.75rem;
  }

  .message {
    font-size: 1rem;
    color: var(--color-on-surface-variant);
    margin: 0 0 2.5rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .link-primary {
    padding: 0.625rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: 0.375rem;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: opacity 150ms;
  }
  .link-primary:hover { opacity: 0.88; }

  .link-secondary {
    padding: 0.625rem 1.5rem;
    border: 1px solid var(--color-outline-variant);
    color: var(--color-on-surface-variant);
    border-radius: 0.375rem;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 150ms, border-color 150ms;
  }
  .link-secondary:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
</style>

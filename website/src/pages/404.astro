---
// 404 page (#7199), on the same remarque shell as the rest of the site.
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE, docsHref } from '../lib/docs-collection.ts';
import { PRIMARY_SECTIONS, sectionIndexHref, sectionLabel } from '../lib/docs-nav.ts';
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <div class="notfound">
    <p class="notfound-kicker">Error 404</p>
    <h1 class="notfound-title">Page not found</h1>
    <p class="notfound-lead">
      The link, the slug, or the page itself is gone. Search the docs from the header, or start
      from one of these:
    </p>
    <ul>
      <li><a href={`${BASE}/`}>Home</a></li>
      <li><a href={docsHref('readme')}>Documentation index</a></li>
      {PRIMARY_SECTIONS.map((key) => (
        <li><a href={sectionIndexHref(BASE, key)}>{sectionLabel(key)}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .notfound {
    max-width: var(--content-reading);
    margin-inline: auto;
    padding: var(--space-9) var(--space-5);
  }
  .notfound-kicker {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-caps: all-small-caps;
    letter-spacing: var(--tracking-caps);
    color: var(--color-fg-muted);
  }
  .notfound-title {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-title);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-title);
  }
  .notfound-lead {
    font-size: var(--text-body-lg);
    color: var(--color-fg-muted);
  }
  .notfound li {
    padding-block: var(--space-1);
  }
</style>

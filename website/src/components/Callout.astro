---
// Callout / status banner (#7199). remarque ships no callout, but sanctions
// its state colors for exactly this: "-subtle" companions are banner
// backgrounds, and every one holds --color-fg at >= 4.5:1 (REMARQUE.md
// "State Colors"). `note` uses --color-accent-subtle, as in the approved
// docs mockup. Body text stays --color-fg; the state color only tints the
// background and marks the title, never decorates.
//
// An <aside> is a complementary landmark, so it is named by its visible
// title (aria-labelledby) rather than left as an anonymous region.
interface Props {
  title: string;
  tone?: 'note' | 'success' | 'warning' | 'error';
}

const { title, tone = 'note' } = Astro.props;
const titleId = `callout-${Math.random().toString(36).slice(2, 10)}`;
---

<aside class:list={['callout', `callout--${tone}`]} aria-labelledby={titleId}>
  <p class="callout-title" id={titleId}>{title}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    --callout-bg: var(--color-accent-subtle);
    --callout-mark: var(--color-accent);
    margin-block: var(--space-5);
    padding: var(--space-4) var(--space-5);
    background: var(--callout-bg);
    color: var(--color-fg);
    border: var(--border-width) var(--border-style) var(--color-border);
    border-radius: var(--radius-md);
  }
  .callout--success {
    --callout-bg: var(--color-success-subtle);
    --callout-mark: var(--color-success);
  }
  .callout--warning {
    --callout-bg: var(--color-warning-subtle);
    --callout-mark: var(--color-warning);
  }
  .callout--error {
    --callout-bg: var(--color-error-subtle);
    --callout-mark: var(--color-error);
  }
  .callout-title {
    margin: 0 0 var(--space-1);
    font-weight: var(--weight-semibold);
    color: var(--color-fg);
  }
  .callout-title::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-inline-end: var(--space-2);
    border-radius: 50%;
    background: var(--callout-mark);
    vertical-align: 0.1em;
  }
  .callout-body :global(p) {
    margin: 0;
  }
  @media (forced-colors: active) {
    .callout {
      border-color: CanvasText;
    }
  }
</style>

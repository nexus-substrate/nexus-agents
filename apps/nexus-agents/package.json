{
  "name": "nexus-agents-app",
  "version": "0.0.1",
  "description": "Main entry point for Nexus Agents",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexus-agents/core": "workspace:*",
    "@nexus-agents/config": "workspace:*",
    "@nexus-agents/adapters": "workspace:*",
    "@nexus-agents/agents": "workspace:*",
    "@nexus-agents/workflows": "workspace:*",
    "@nexus-agents/mcp": "workspace:*",
    "@nexus-agents/cli": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}

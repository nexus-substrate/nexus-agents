    "npm": "https://www.npmjs.com/package/nexus-agents"
  },
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "sort": ["source-order"],
  "visibilityFilters": {
    "protected": true,
    "@internal": false
  },
  "plugin": [],
  "gitRevision": "main",
  "searchInComments": true,

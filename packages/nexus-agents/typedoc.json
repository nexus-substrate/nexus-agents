{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "name": "nexus-agents",
  "includeVersion": true,
  "readme": "README.md",
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "categorizeByGroup": true,
  "categoryOrder": [
    "Core",
    "Result",
    "Errors",
    "Agents",
    "Experts",
    "Consensus",
    "Workflows",
    "MCP",
    "CLI Adapters",
    "Config",
    "Tracing",
    "Testing",
    "*"
  ],
  "navigationLinks": {
    "GitHub": "https://github.com/williamzujkowski/nexus-agents",
    "npm": "https://www.npmjs.com/package/nexus-agents"
  },
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "sort": ["source-order"],
  "visibilityFilters": {
    "protected": true,
    "@internal": false
  },
  "plugin": [],
  "gitRevision": "main",
  "searchInComments": true
}

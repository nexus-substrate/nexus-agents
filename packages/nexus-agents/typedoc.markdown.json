{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/exports/core.ts",
    "src/exports/config.ts",
    "src/exports/adapters.ts",
    "src/exports/agents.ts",
    "src/exports/agents-skills.ts",
    "src/exports/agents-ictm.ts",
    "src/exports/workflows.ts",
    "src/exports/mcp.ts",
    "src/exports/cli-adapters.ts",
    "src/exports/context.ts",
    "src/exports/learning.ts",
    "src/exports/audit.ts",
    "src/exports/security.ts",
    "src/exports/consensus.ts",
    "src/exports/observability.ts",
    "src/exports/orchestration.ts",
    "src/exports/benchmarks.ts",
    "src/exports/pipeline.ts",
    "src/exports/scm.ts"
  ],
  "tsconfig": "tsconfig.docs.json",
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/*.fuzz.test.ts"],
  "out": "../../docs/api",
  "name": "nexus-agents API",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-plugin-frontmatter",
    "./scripts/typedoc-astro-title.mjs"
  ],
  "excludePrivate": true,
  "excludeInternal": true,
  "readme": "none",
  "githubPages": false,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "outputFileStrategy": "modules",
  "entryFileName": "index",
  "frontmatterGlobals": {
    "tier": 2
  }
}

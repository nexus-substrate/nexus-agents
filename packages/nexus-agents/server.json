{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.williamzujkowski/nexus-agents",
  "description": "Intelligent orchestration platform for AI coding tools. Routes tasks to the best model (Claude, Codex, Gemini, OpenCode) using data-driven algorithms (LinUCB, TOPSIS), enforces quality through multi-model consensus voting, and learns from outcomes across sessions. 35 MCP tools, 8 memory backends, full dev pipeline with research/plan/vote/implement/QA stages.",
  "repository": {
    "url": "https://github.com/williamzujkowski/nexus-agents",
    "source": "github"
  },
  "version": "2.63.6",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "nexus-agents",
      "version": "2.63.6",
      "runtime": "node",
      "runtimeArguments": ["--experimental-vm-modules"],
      "packageArguments": ["--mode=server"],
      "environmentVariables": [
        {
          "name": "ANTHROPIC_API_KEY",
          "description": "API key for Claude adapter",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "OPENAI_API_KEY",
          "description": "API key for OpenAI/Codex adapter",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "GOOGLE_AI_API_KEY",
          "description": "API key for Gemini adapter",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "OPENROUTER_API_KEY",
          "description": "API key for OpenRouter adapter (free models)",
          "isRequired": false,
          "isSecret": true
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "tools": [
    "orchestrate",
    "create_expert",
    "execute_expert",
    "consensus_vote",
    "delegate_to_model",
    "run_workflow",
    "run_graph_workflow",
    "list_experts",
    "list_workflows",
    "research_query",
    "research_add",
    "research_add_source",
    "research_discover",
    "research_analyze",
    "research_catalog_review",
    "research_synthesize",
    "survey_oss_landscape",
    "memory_query",
    "memory_stats",
    "memory_write",
    "weather_report",
    "issue_triage",
    "execute_spec",
    "registry_import",
    "repo_analyze",
    "repo_security_plan",
    "search_codebase",
    "extract_symbols",
    "query_trace",
    "query_task_state",
    "verify_audit_chain",
    "run_dev_pipeline",
    "run_pipeline",
    "pr_review",
    "supply_chain_tradeoff_panel"
  ]
}

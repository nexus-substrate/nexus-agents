{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/registry/main/schema/server.json",
  "name": "io.github.williamzujkowski/nexus-agents",
  "description": "Multi-agent orchestration MCP server. Routes tasks to specialized experts (Claude, Gemini, Codex, OpenCode) with consensus voting, adaptive routing, and 24 MCP tools.",
  "repository": {
    "type": "git",
    "url": "https://github.com/williamzujkowski/nexus-agents"
  },
  "version_detail": {
    "version": "2.28.0",
    "release_date": "2026-04-07"
  },
  "packages": [
    {
      "registry_type": "npm",
      "name": "nexus-agents",
      "version": "2.28.0",
      "runtime": "node",
      "runtime_arguments": ["--experimental-vm-modules"],
      "package_arguments": ["--mode=server"],
      "environment_variables": [
        {
          "name": "ANTHROPIC_API_KEY",
          "description": "API key for Claude adapter",
          "required": false
        },
        {
          "name": "OPENAI_API_KEY",
          "description": "API key for OpenAI/Codex adapter",
          "required": false
        },
        {
          "name": "GOOGLE_AI_API_KEY",
          "description": "API key for Gemini adapter",
          "required": false
        },
        {
          "name": "OPENROUTER_API_KEY",
          "description": "API key for OpenRouter adapter (free models)",
          "required": false
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "tools": [
    "orchestrate",
    "create_expert",
    "execute_expert",
    "consensus_vote",
    "delegate_to_model",
    "run_workflow",
    "run_graph_workflow",
    "list_experts",
    "list_workflows",
    "research_query",
    "research_add",
    "research_discover",
    "research_analyze",
    "research_synthesize",
    "memory_query",
    "memory_stats",
    "memory_write",
    "weather_report",
    "issue_triage",
    "execute_spec",
    "registry_import",
    "repo_analyze",
    "repo_security_plan",
    "search_codebase",
    "extract_symbols",
    "query_trace",
    "research_add_source",
    "research_catalog_review",
    "run_dev_pipeline"
  ]
}

{
  "name": "nexus-agents",
  "version": "15.1.1",
  "description": "Governance substrate for AI coding agents — adversarial PR review, drift-detected rules, tamper-evident audit, and closed-loop outcome routing for Claude, Codex, Gemini, and OpenCode",
  "mcpName": "io.github.nexus-substrate/nexus-agents",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nexus-agents": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/workflows/templates",
    "src/security/ast-rules",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexus-substrate/nexus-agents.git"
  },
  "homepage": "https://github.com/nexus-substrate/nexus-agents#readme",
  "bugs": {
    "url": "https://github.com/nexus-substrate/nexus-agents/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "directory": ".publish-stage",
    "linkDirectory": false
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "multi-agent",
    "governance",
    "code-review",
    "consensus",
    "audit",
    "orchestration",
    "claude",
    "codex",
    "openai",
    "gemini",
    "opencode",
    "ollama",
    "llm",
    "workflow"
  ],
  "author": "William Zujkowski",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && pnpm exec tsx ../../scripts/check-dist-assets.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:api:md": "typedoc --options typedoc.markdown.json",
    "prepublishOnly": "pnpm run build && pnpm exec tsx ../../scripts/check-publish-stage.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/napi": "0.51.0",
    "@google/genai": "^2.31.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "jsonc-parser": "^3.3.1",
    "ollama": "^0.6.4",
    "openai": "^7.43.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "tiktoken": "^1.0.22",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "undici": "^6.29.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.135",
    "@ai-sdk/google": "^3.0.137",
    "@ai-sdk/openai": "^4.0.101",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "4.1.12",
    "ai": "^7.0.150",
    "fast-check": "^4.10.2",
    "nexus-memory": "workspace:*",
    "tsup": "^8.5.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-frontmatter": "1.3.3",
    "typedoc-plugin-markdown": "4.14.1",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0 || ^4.0.0",
    "ai": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    }
  }
}

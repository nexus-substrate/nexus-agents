{
  "name": "@nexus-agents/agents",
  "version": "0.0.1",
  "description": "Agent framework (TechLead, Experts) for Nexus Agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamzujkowski/nexus-agents.git",
    "directory": "packages/agents"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@nexus-agents/core": "workspace:*",
    "@nexus-agents/adapters": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}

{
  "name": "nexus-memory",
  "version": "1.0.1",
  "description": "Unified memory subsystem for nexus-agents and nexus-eval-* — IMemoryBackend contract, MemoryRegistry, telemetry, one-shot importer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexus-substrate/nexus-agents.git",
    "directory": "packages/nexus-memory"
  },
  "homepage": "https://github.com/nexus-substrate/nexus-agents/tree/main/packages/nexus-memory#readme",
  "keywords": [
    "memory",
    "mcp",
    "agent",
    "nexus-agents",
    "sqlite",
    "imemorybackend"
  ],
  "author": "William Zujkowski",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  }
}

{
  "name": "@nexus-agents/workflows",
  "version": "1.0.0",
  "description": "Workflow engine and templates for Nexus Agents",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/templates",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamzujkowski/nexus-agents.git",
    "directory": "packages/workflows"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts && cp -r src/templates dist/",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@nexus-agents/agents": "workspace:*",
    "@nexus-agents/core": "workspace:*",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0",
    "tsup": "^8.3.0"
  }
}

{
  "name": "nexus-agents",
  "version": "2.8.0",
  "description": "Intelligent orchestration platform for AI coding tools — routes tasks to the best model, learns from outcomes, and enforces quality through multi-model consensus",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "https://github.com/williamzujkowski/nexus-agents.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "claude",
    "openai",
    "llm"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:arch": "npx tsx scripts/arch-lint.ts",
    "lint:md": "markdownlint 'docs/**/*.md' '*.md' --ignore 'docs/api/**' --ignore 'node_modules' --config .markdownlint.json",
    "lint:md:fix": "markdownlint 'docs/**/*.md' '*.md' --ignore 'docs/api/**' --ignore 'node_modules' --config .markdownlint.json --fix",
    "spell": "cspell 'docs/**/*.md' '*.md' --config cspell.json",
    "spell:all": "cspell '**/*.{md,ts,tsx}' --config cspell.json",
    "governance:inject": "npx tsx scripts/inject-governance.ts inject",
    "governance:check": "npx tsx scripts/inject-governance.ts check",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "research:generate": "npx tsx scripts/update-research-index.ts",
    "research:check": "npx tsx scripts/update-research-index.ts --check",
    "research:validate": "npx tsx scripts/update-research-index.ts --validate",
    "check:pricing-drift": "npx tsx scripts/check-pricing-drift.ts",
    "review": "npx tsx scripts/review-pr.ts",
    "link-check": "npx lychee --config lychee.toml .",
    "changeset": "changeset",
    "changeset:version": "changeset version && npx tsx scripts/sync-plugin-version.ts && pnpm governance:inject && npx tsx scripts/generate-repo-index.ts && npx tsx scripts/generate-docs-content.ts && pnpm --filter nexus-agents docs",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "cspell": "^10.0.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "tslib": "^2.8.1",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk>ajv": ">=8.18.0",
      "hono": ">=4.12.14",
      "@hono/node-server": ">=1.19.13",
      "@isaacs/brace-expansion": ">=5.0.1",
      "markdown-it": ">=14.1.1",
      "qs": ">=6.14.2",
      "basic-ftp": ">=5.3.0",
      "defu": ">=6.1.5",
      "smol-toml": ">=1.6.1",
      "markdownlint-cli>minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "@modelcontextprotocol/sdk>express-rate-limit": ">=8.3.0",
      "lodash": ">=4.17.23",
      "flatted@<=3.4.1": ">=3.4.2",
      "h3@<1.15.9": ">=1.15.9",
      "h3@<=1.15.8": ">=1.15.9",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "picomatch": ">=4.0.4",
      "vite": ">=7.3.2",
      "yaml@<2.8.3": ">=2.8.3",
      "protobufjs@<7.5.5": "^7.5.5",
      "encoding-sniffer@<1.0.0": "^1.0.0"
    }
  }
}

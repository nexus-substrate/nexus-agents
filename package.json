{
  "name": "nexus-agents",
  "version": "2.3.0",
  "description": "Multi-agent orchestration MCP server with model diversity and workflow automation",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "https://github.com/williamzujkowski/nexus-agents.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "claude",
    "openai",
    "llm"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "review": "npx tsx scripts/review-pr.ts",
    "link-check": "npx lychee --config lychee.toml ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.19.7",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "markdown-link-check": "^3.14.2",
    "prettier": "^3.8.1",
    "turbo": "^2.7.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.53.1",
    "vitest": "^3.0.0",
    "yaml": "^2.8.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.11.4",
      "@hono/node-server": "^1.19.9"
    }
  }
}

{
  "name": "nexus-agents",
  "version": "2.8.0",
  "description": "Intelligent orchestration platform for AI coding tools — routes tasks to the best model, learns from outcomes, and enforces quality through multi-model consensus",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexus-substrate/nexus-agents.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "claude",
    "openai",
    "llm"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:scripts": "vitest run",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:scripts": "eslint scripts/",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint:arch": "npx tsx scripts/arch-lint.ts",
    "api:surface": "npx tsx scripts/extract-api-surface.ts > api-surface.txt",
    "api:check": "npx tsx scripts/check-api-surface.ts",
    "lint:md": "markdownlint 'docs/**/*.md' '*.md' --ignore 'docs/api/**' --ignore 'node_modules' --config .markdownlint.json",
    "lint:md:fix": "markdownlint 'docs/**/*.md' '*.md' --ignore 'docs/api/**' --ignore 'node_modules' --config .markdownlint.json --fix",
    "spell": "cspell 'docs/**/*.md' '*.md' --config cspell.json",
    "spell:all": "cspell '**/*.{md,ts,tsx}' --config cspell.json",
    "governance:inject": "npx tsx scripts/inject-governance.ts inject",
    "governance:check": "npx tsx scripts/inject-governance.ts check",
    "claims:check": "npx tsx scripts/claims-check.ts",
    "strategy-manifest:check": "npx tsx scripts/check-strategy-manifest-drift.ts",
    "authority-tier:check": "npx tsx scripts/check-authority-tier-drift.ts",
    "docs:tools": "npx tsx scripts/generate-tool-reference.ts",
    "docs:tools:check": "npx tsx scripts/generate-tool-reference.ts --check",
    "docs:strategies": "npx tsx scripts/generate-strategy-reference.ts",
    "docs:strategies:check": "npx tsx scripts/generate-strategy-reference.ts --check",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "research:generate": "npx tsx scripts/update-research-index.ts",
    "research:check": "npx tsx scripts/update-research-index.ts --check",
    "research:validate": "npx tsx scripts/update-research-index.ts --validate",
    "check:pricing-drift": "npx tsx scripts/check-pricing-drift.ts",
    "check:parameter-drift": "npx tsx scripts/check-parameter-drift.ts",
    "check:model-drift": "npx tsx scripts/check-model-string-drift.ts",
    "build:registry": "npx tsx scripts/build-model-registry.ts",
    "build:registry:dry": "npx tsx scripts/build-model-registry.ts --dry",
    "review": "npx tsx scripts/review-pr.ts",
    "eval:mine-candidates": "npx tsx scripts/mine-pr-review-candidates.ts",
    "eval:run": "npx tsx scripts/pr-review-eval-run.ts",
    "link-check": "npx lychee --config lychee.toml .",
    "git:cleanup": "./scripts/git-housekeeping.sh",
    "git:cleanup:dry": "./scripts/git-housekeeping.sh --dry-run",
    "git:cleanup:branches": "./scripts/git-housekeeping.sh --include-squash-merged",
    "git:cleanup:branches:dry": "./scripts/git-housekeeping.sh --include-squash-merged --dry-run",
    "changeset": "changeset",
    "changeset:version": "npx tsx scripts/changeset-version-with-retry.ts && npx tsx scripts/sync-plugin-version.ts && pnpm governance:inject && npx tsx scripts/generate-repo-index.ts && npx tsx scripts/generate-docs-content.ts",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && changeset publish",
    "check:catalogue-drift": "npx tsx scripts/check-catalogue-drift.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@changesets/read": "1.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.11",
    "cspell": "^10.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "ts-morph": "^27.0.2",
    "tslib": "^2.8.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "zod": "^4.5.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk>ajv": ">=8.18.0",
      "hono": ">=4.12.21",
      "@hono/node-server": ">=1.19.13",
      "ws": ">=8.21.0",
      "esbuild": ">=0.28.1",
      "dompurify": ">=3.4.11",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5.0.0",
      "js-yaml@>=5.0.0": "4.3.1",
      "js-yaml@<4.0.0": ">=3.15.1 <4.0.0",
      "undici": ">=6.28.0 <7",
      "postcss": ">=8.5.23",
      "svgo": ">=4.0.2",
      "sharp": ">=0.35.0",
      "fast-uri": ">=4.1.3",
      "ip-address": ">=10.2.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "markdown-it": ">=14.2.0",
      "qs": ">=6.16.0",
      "basic-ftp": ">=5.3.0",
      "defu": ">=6.1.5",
      "smol-toml": ">=1.6.1",
      "markdownlint-cli>minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "@modelcontextprotocol/sdk>express-rate-limit": ">=8.5.1",
      "lodash": ">=4.17.23",
      "flatted@<=3.4.1": ">=3.4.2",
      "h3@<1.15.9": ">=1.15.9",
      "h3@<=1.15.8": ">=1.15.9",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "picomatch": ">=4.0.4",
      "vite": ">=8.0.13",
      "yaml@<2.8.3": ">=2.8.3",
      "protobufjs@<7.6.3": ">=7.6.3",
      "encoding-sniffer@<1.0.0": "^1.0.0",
      "uuid@<14.0.0": ">=14.0.0"
    }
  }
}

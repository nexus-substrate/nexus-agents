{
  "name": "nexus-agents",
  "version": "2.5.0",
  "description": "Multi-agent orchestration MCP server with model diversity and workflow automation",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "https://github.com/williamzujkowski/nexus-agents.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "multi-agent",
    "orchestration",
    "claude",
    "openai",
    "llm"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:arch": "npx tsx scripts/arch-lint.ts",
    "lint:md": "markdownlint 'docs/**/*.md' '*.md' --ignore 'docs/api/**' --ignore 'node_modules' --config .markdownlint.json",
    "lint:md:fix": "markdownlint 'docs/**/*.md' '*.md' --ignore 'docs/api/**' --ignore 'node_modules' --config .markdownlint.json --fix",
    "spell": "cspell 'docs/**/*.md' '*.md' --config cspell.json",
    "spell:all": "cspell '**/*.{md,ts,tsx}' --config cspell.json",
    "governance:inject": "npx tsx scripts/inject-governance.ts inject",
    "governance:check": "npx tsx scripts/inject-governance.ts check",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "research:generate": "npx tsx scripts/update-research-index.ts",
    "research:check": "npx tsx scripts/update-research-index.ts --check",
    "research:validate": "npx tsx scripts/update-research-index.ts --validate",
    "review": "npx tsx scripts/review-pr.ts",
    "link-check": "npx lychee --config lychee.toml .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^22.19.10",
    "@vitest/coverage-v8": "^3.2.4",
    "cspell": "^8.17.3",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli": "^0.47.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.11.7",
      "@hono/node-server": "^1.19.9",
      "@isaacs/brace-expansion": ">=5.0.1"
    }
  }
}

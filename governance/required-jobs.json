{
  "description": "Governor-owned requirements for CI Success wiring and branch-protection contexts.",
  "version": "2.0.0",
  "ci_success_needs": [
    "commitlint",
    "changeset-check",
    "lint",
    "typecheck",
    "build",
    "test",
    "fitness-audit",
    "consolidation-test",
    "producer-consumer-check",
    "script-tests",
    "model-string-drift",
    "security"
  ],
  "skip_allowed": ["commitlint", "changeset-check", "producer-consumer-check"],
  "required_contexts": {
    "CI Success": { "workflow": "ci.yml", "job": "ci-success" },
    "Governor-path ratification gate": {
      "workflow": "governor-review.yml",
      "job": "governor-ratification"
    }
  },
  "audit_config_forbidden": true
}
